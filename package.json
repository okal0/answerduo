{
  "name": "answerduo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.ts",
    "test": "node --test test.ts accounts.test.ts cloudflare.test.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "node scripts/build-cloudflare.mjs && wrangler dev",
