    "qrcode": "^1.5.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.65.0",
    "wrangler": "^4.158.0"
  }
