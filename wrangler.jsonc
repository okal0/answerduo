{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "account_id": "f2f22daee96d6e3ab386d09d46c7c93b",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/app", "/phone", "/account", "/admin", "/pricing", "/how-it-works", "/api/*", "/socket"]
  },
  "durable_objects": {
    "bindings": [
      {"name": "ACCOUNTS", "class_name": "AccountStore"},
      {"name": "ROOMS", "class_name": "InterviewRoom"}
    ]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AccountStore", "InterviewRoom"]}],
  "observability": {"enabled": false}
}
